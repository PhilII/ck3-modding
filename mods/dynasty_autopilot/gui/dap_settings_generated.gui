	type dap_tab_buttons = hbox {
		layoutpolicy_horizontal = expanding
		margin = { 10 0 }
		button_tab = {
			layoutpolicy_horizontal = expanding
			text = "dap_tab_general"
			onclick = "[GetVariableSystem.Set( 'dap_tab', 'general' )]"
			down = "[GetVariableSystem.HasValue( 'dap_tab', 'general' )]"
		}
		button_tab = {
			layoutpolicy_horizontal = expanding
			text = "dap_tab_marriage"
			onclick = "[GetVariableSystem.Set( 'dap_tab', 'marriage' )]"
			down = "[GetVariableSystem.HasValue( 'dap_tab', 'marriage' )]"
		}
		button_tab = {
			layoutpolicy_horizontal = expanding
			text = "dap_tab_guardians"
			onclick = "[GetVariableSystem.Set( 'dap_tab', 'guardians' )]"
			down = "[GetVariableSystem.HasValue( 'dap_tab', 'guardians' )]"
		}
		button_tab = {
			layoutpolicy_horizontal = expanding
			text = "dap_tab_education"
			onclick = "[GetVariableSystem.Set( 'dap_tab', 'education' )]"
			down = "[GetVariableSystem.HasValue( 'dap_tab', 'education' )]"
		}
		button_tab = {
			layoutpolicy_horizontal = expanding
			text = "dap_tab_court"
			onclick = "[GetVariableSystem.Set( 'dap_tab', 'court' )]"
			down = "[GetVariableSystem.HasValue( 'dap_tab', 'court' )]"
		}
	}

	type dap_settings_view = vbox {
		layoutpolicy_horizontal = expanding
		dap_module_general_player = {
			visible = "[GetVariableSystem.HasValue( 'dap_tab', 'general' )]"
		}
		dap_module_marriage_player = {
			visible = "[GetVariableSystem.HasValue( 'dap_tab', 'marriage' )]"
		}
		dap_module_guardians_player = {
			visible = "[GetVariableSystem.HasValue( 'dap_tab', 'guardians' )]"
		}
		dap_module_education_player = {
			visible = "[GetVariableSystem.HasValue( 'dap_tab', 'education' )]"
		}
		dap_module_court_player = {
			visible = "[GetVariableSystem.HasValue( 'dap_tab', 'court' )]"
		}
	}

	type dap_rules_view = vbox {
		layoutpolicy_horizontal = expanding
		dap_module_marriage_rules = {
			visible = "[GetVariableSystem.HasValue( 'dap_tab', 'marriage' )]"
		}
		dap_module_guardians_rules = {
			visible = "[GetVariableSystem.HasValue( 'dap_tab', 'guardians' )]"
		}
		dap_module_education_rules = {
			visible = "[GetVariableSystem.HasValue( 'dap_tab', 'education' )]"
		}
	}

	type dap_presets_row = hbox {
		spacing = 6
		button_standard = {
			size = { 120 30 }
			text = "dap_preset_breeding"
			tooltip = "dap_preset_breeding_tt"
			onclick = "[GetScriptedGui( 'dap_apply_preset' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'holder', Character.MakeScope ).AddScope( 'preset', MakeScopeFlag( 'dap_preset_breeding' ) ).End )]"
		}
		button_standard = {
			size = { 120 30 }
			text = "dap_preset_power"
			tooltip = "dap_preset_power_tt"
			onclick = "[GetScriptedGui( 'dap_apply_preset' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'holder', Character.MakeScope ).AddScope( 'preset', MakeScopeFlag( 'dap_preset_power' ) ).End )]"
		}
		button_standard = {
			size = { 120 30 }
			text = "dap_preset_cheap"
			tooltip = "dap_preset_cheap_tt"
			onclick = "[GetScriptedGui( 'dap_apply_preset' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'holder', Character.MakeScope ).AddScope( 'preset', MakeScopeFlag( 'dap_preset_cheap' ) ).End )]"
		}
	}

	type dap_slots_row = hbox {
		spacing = 6
		button_standard_small = {
			size = { 70 26 }
			text = "dap_slot_save_1"
			tooltip = "dap_slot_save_1_tt"
			onclick = "[GetScriptedGui( 'dap_save_slot' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'holder', Character.MakeScope ).AddScope( 'slot', MakeScopeFlag( 'dap_slot_1' ) ).End )]"
		}
		button_standard_small = {
			size = { 70 26 }
			text = "dap_slot_load_1"
			tooltip = "dap_slot_load_1_tt"
			enabled = "[GetPlayer.MakeScope.Var('dap_slot1_saved').IsSet]"
			onclick = "[GetScriptedGui( 'dap_load_slot' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'holder', Character.MakeScope ).AddScope( 'slot', MakeScopeFlag( 'dap_slot_1' ) ).End )]"
		}
		button_standard_small = {
			size = { 70 26 }
			text = "dap_slot_save_2"
			tooltip = "dap_slot_save_2_tt"
			onclick = "[GetScriptedGui( 'dap_save_slot' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'holder', Character.MakeScope ).AddScope( 'slot', MakeScopeFlag( 'dap_slot_2' ) ).End )]"
		}
		button_standard_small = {
			size = { 70 26 }
			text = "dap_slot_load_2"
			tooltip = "dap_slot_load_2_tt"
			enabled = "[GetPlayer.MakeScope.Var('dap_slot2_saved').IsSet]"
			onclick = "[GetScriptedGui( 'dap_load_slot' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'holder', Character.MakeScope ).AddScope( 'slot', MakeScopeFlag( 'dap_slot_2' ) ).End )]"
		}
		button_standard_small = {
			size = { 70 26 }
			text = "dap_slot_save_3"
			tooltip = "dap_slot_save_3_tt"
			onclick = "[GetScriptedGui( 'dap_save_slot' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'holder', Character.MakeScope ).AddScope( 'slot', MakeScopeFlag( 'dap_slot_3' ) ).End )]"
		}
		button_standard_small = {
			size = { 70 26 }
			text = "dap_slot_load_3"
			tooltip = "dap_slot_load_3_tt"
			enabled = "[GetPlayer.MakeScope.Var('dap_slot3_saved').IsSet]"
			onclick = "[GetScriptedGui( 'dap_load_slot' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'holder', Character.MakeScope ).AddScope( 'slot', MakeScopeFlag( 'dap_slot_3' ) ).End )]"
		}
	}
}

template dap_rules_tab_visible
{
	visible = "[Or( GetVariableSystem.HasValue( 'dap_tab', 'marriage' ), Or( GetVariableSystem.HasValue( 'dap_tab', 'guardians' ), GetVariableSystem.HasValue( 'dap_tab', 'education' ) ) )]"
}

template dap_show_rules_view
{
	visible = "[And( Or( GetVariableSystem.HasValue( 'dap_tab', 'marriage' ), Or( GetVariableSystem.HasValue( 'dap_tab', 'guardians' ), GetVariableSystem.HasValue( 'dap_tab', 'education' ) ) ), GetVariableSystem.HasValue( 'dap_view', 'rules' ) )]"
}

template dap_show_settings_view
{
	visible = "[Or( Not( Or( GetVariableSystem.HasValue( 'dap_tab', 'marriage' ), Or( GetVariableSystem.HasValue( 'dap_tab', 'guardians' ), GetVariableSystem.HasValue( 'dap_tab', 'education' ) ) ) ), Not( GetVariableSystem.HasValue( 'dap_view', 'rules' ) ) )]"
}

